# Copy to .env and fill in. Never commit .env.
AWS_REGION=ap-southeast-2
# Model or inference-profile ID from Bedrock console -> Model catalog (Claude model).
BEDROCK_MODEL_ID=
# Only if you don't use `aws configure` or an IAM role:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional, for the API (uvicorn). On Lambda the SAM template sets these.
# ANYCART_TABLE=        # DynamoDB table name; leave unset to keep state in memory
# ANYCART_API_KEY=      # if set, requests need the header x-api-key
